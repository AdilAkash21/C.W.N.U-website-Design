generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  STAFF
  ADMIN
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  DROPPED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentType {
  HOMEWORK
  QUIZ
  MIDTERM
  FINAL
  PROJECT
  PRESENTATION
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum NoticeType {
  GENERAL
  ACADEMIC
  EVENT
  URGENT
  MAINTENANCE
}

enum ActivityType {
  LOGIN
  LOGOUT
  COURSE_ENROLL
  COURSE_DROP
  ASSIGNMENT_SUBMIT
  GRADE_RECEIVED
  ATTENDANCE_RECORDED
  PROFILE_UPDATE
  PASSWORD_CHANGE
  NOTICE_VIEW
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(STUDENT)
  avatar        String?
  phone         String?
  dateOfBirth   DateTime?
  address       String?
  bio           String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments            Enrollment[]
  taughtCourses          Course[]          @relation("TeacherCourses")
  departments            Department[]      @relation("DepartmentHead")
  submissions            Submission[]      @relation("StudentSubmissions")
  gradedSubmissions      Submission[]      @relation("GradedSubmissions")
  notices                Notice[]          @relation("NoticeAuthor")
  activities             Activity[]
  refreshTokens          RefreshToken[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  headId      String?
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  facultyId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@index([code])
  @@index([isActive])
}

model CourseSchedule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  room      String
  building  String

  @@unique([courseId, dayOfWeek, startTime])
}

model Course {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  credits       Int      @default(3)
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teacherId     String?
  teacher       User?    @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  semester      String
  year          Int
  maxStudents   Int      @default(30)
  enrolledCount Int      @default(0)
  prerequisites String[]
  syllabus      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   Enrollment[]
  schedules     CourseSchedule[]
  assignments   Assignment[]

  @@index([departmentId])
  @@index([teacherId])
  @@index([semester, year])
  @@index([isActive])
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(PENDING)
  grade      String?
  gradePoints Float?
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  attendances Attendance[]
  submissions Submission[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

model Attendance {
  id          String            @id @default(cuid())
  enrollmentId String
  enrollment  Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId      String?
  date        DateTime
  status      AttendanceStatus  @default(PRESENT)
  notes       String?
  recordedAt  DateTime          @default(now())

  @@unique([enrollmentId, date])
  @@index([enrollmentId])
  @@index([date])
  @@index([status])
}

model Assignment {
  id                  String         @id @default(cuid())
  courseId            String
  course              Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId              String?
  title               String
  description         String
  type                AssignmentType @default(HOMEWORK)
  maxPoints           Int            @default(100)
  weight              Float          @default(1.0)
  assignedAt          DateTime       @default(now())
  dueAt               DateTime
  allowLateSubmission Boolean        @default(false)
  latePenalty         Float?
  attachments         String[]
  isPublished         Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  submissions Submission[]

  @@index([courseId])
  @@index([dueAt])
  @@index([isPublished])
}

model Submission {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User               @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  content      String?
  attachments  String[]
  submittedAt  DateTime           @default(now())
  gradedAt     DateTime?
  pointsEarned Int?
  feedback     String?
  gradedBy     String?
  grader       User?              @relation("GradedSubmissions", fields: [gradedBy], references: [id], onDelete: SetNull)
  status       SubmissionStatus   @default(SUBMITTED)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([status])
}

model Notice {
  id          String      @id @default(cuid())
  title       String
  content     String
  type        NoticeType  @default(GENERAL)
  targetRoles UserRole[]
  authorId    String
  author      User        @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  publishAt   DateTime    @default(now())
  expireAt    DateTime?
  isPinned    Boolean     @default(false)
  isPublished Boolean     @default(false)
  attachments String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([authorId])
  @@index([publishAt])
  @@index([isPublished])
  @@index([type])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActivityType
  description String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}