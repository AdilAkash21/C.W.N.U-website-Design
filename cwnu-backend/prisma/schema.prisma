generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  STAFF
  ADMIN
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  DROPPED
  COMPLETED
}

enum CourseRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  NOT_RECORDED
}

enum AttendanceSessionStatus {
  SCHEDULED
  OPEN
  ATTENDANCE_IN_PROGRESS
  SAVED
  CLOSED
  CANCELLED
  REOPENED
}

enum AttendanceMode {
  MANUAL
  AUTOMATIC
  CHECK_IN
}

enum AttendanceInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AssignmentType {
  HOMEWORK
  QUIZ
  MIDTERM
  FINAL
  PROJECT
  PRESENTATION
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum TestAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum NoticeType {
  GENERAL
  ACADEMIC
  EVENT
  URGENT
  MAINTENANCE
}

enum ContactMessageStatus {
  NEW
  READ
  IN_PROGRESS
  REPLIED
  RESOLVED
  CLOSED
}

enum ActivityType {
  LOGIN
  LOGOUT
  COURSE_ENROLL
  COURSE_ASSIGNMENT
  COURSE_DROP
  ASSIGNMENT_SUBMIT
  GRADE_RECEIVED
  ATTENDANCE_RECORDED
  ATTENDANCE_INVITED
  ATTENDANCE_ACCEPTED
  TEST_PUBLISHED
  PROFILE_UPDATE
  PASSWORD_CHANGE
  NOTICE_VIEW
  SYSTEM_ERROR
}

enum ErrorIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorIncidentStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  REOPENED
  IGNORED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(STUDENT)
  avatar        String?
  phone         String?
  dateOfBirth   DateTime?
  address       String?
  bio           String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enrollments            Enrollment[]
  taughtCourses          Course[]          @relation("TeacherCourses")
  assignedCourses        Course[]          @relation("CourseAssignments")
  courseRequests         CourseRequest[]   @relation("TeacherCourseRequests")
  reviewedCourseRequests  CourseRequest[]  @relation("CourseRequestReviewer")
  reviewedEnrollments     Enrollment[]     @relation("EnrollmentReviewer")
  departments            Department[]      @relation("DepartmentHead")
  submissions            Submission[]      @relation("StudentSubmissions")
  gradedSubmissions      Submission[]      @relation("GradedSubmissions")
  notices                Notice[]          @relation("NoticeAuthor")
  activities             Activity[]
  contactConversations   ContactConversation[] @relation("ContactOwner")
  assignedConversations  ContactConversation[] @relation("ContactAssignee")
  contactMessages        ContactMessage[]
  refreshTokens          RefreshToken[]
  attendanceSessions     AttendanceSession[] @relation("TeacherAttendanceSessions")
  recordedAttendance     AttendanceRecord[] @relation("RecordedAttendanceRecords")
  createdTests            Test[]            @relation("TestCreator")
  testAttempts           TestAttempt[]      @relation("TestAttempts")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  headId      String?
  head        User?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  facultyId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@index([code])
  @@index([isActive])
}

model CourseSchedule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  room      String
  building  String

  @@unique([courseId, dayOfWeek, startTime])
}

model Course {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  credits       Int      @default(3)
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teacherId     String?
  teacher       User?    @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  assignedById  String?
  assignedBy    User?    @relation("CourseAssignments", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt    DateTime?
  semester      String
  year          Int
  maxStudents   Int      @default(30)
  enrolledCount Int      @default(0)
  prerequisites String[]
  syllabus      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   Enrollment[]
  schedules     CourseSchedule[]
  assignments   Assignment[]
  courseRequests CourseRequest[]
  teachingPlan TeachingPlan?
  attendanceSessions AttendanceSession[]
  tests             Test[]

  @@index([departmentId])
  @@index([teacherId])
  @@index([semester, year])
  @@index([isActive])
}

model TeachingPlan {
  id             String   @id @default(cuid())
  courseId       String   @unique
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  objectives     String[]
  outcomes       String[]
  resources      String[]
  startDate      DateTime?
  endDate        DateTime?
  completionDate DateTime?
  createdById    String
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  entries        TeachingPlanEntry[]

  @@index([updatedAt])
}

model TeachingPlanEntry {
  id             String       @id @default(cuid())
  planId         String
  plan           TeachingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  month          Int
  week           Int
  topic          String
  lesson         String?
  activity       String?
  assignment     String?
  project        String?
  assessment     String?
  milestone      String?
  resource       String?
  completionDate DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([planId, month, week])
}

model CourseRequest {
  id         String             @id @default(cuid())
  teacherId  String
  teacher    User               @relation("TeacherCourseRequests", fields: [teacherId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     CourseRequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy User?              @relation("CourseRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([teacherId, courseId])
  @@index([status])
  @@index([courseId])
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(PENDING)
  reviewedById String?
  reviewedBy User?           @relation("EnrollmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  grade      String?
  gradePoints Float?
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  attendances Attendance[]
  attendanceInvitations AttendanceInvitation[]
  attendanceRecords AttendanceRecord[]
  submissions Submission[]

  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

model Attendance {
  id          String            @id @default(cuid())
  enrollmentId String
  enrollment  Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId      String?
  date        DateTime
  status      AttendanceStatus  @default(PRESENT)
  notes       String?
  recordedAt  DateTime          @default(now())

  @@unique([enrollmentId, date])
  @@index([enrollmentId])
  @@index([date])
  @@index([status])
}

model AttendanceSession {
  id          String                  @id @default(cuid())
  courseId    String
  course      Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User                    @relation("TeacherAttendanceSessions", fields: [teacherId], references: [id], onDelete: Restrict)
  title       String
  description String?
  date        DateTime
  sessionStartAt DateTime?
  sessionEndAt DateTime?
  durationMinutes Int @default(60)
  opensAt     DateTime?
  closesAt    DateTime?
  attendanceMode AttendanceMode @default(MANUAL)
  gracePeriodMinutes Int @default(10)
  status      AttendanceSessionStatus @default(SCHEDULED)
  notes       String?
  reopenedAt DateTime?
  reopenExpiresAt DateTime?
  reopenUsed Boolean @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  invitations AttendanceInvitation[]
  records     AttendanceRecord[]

  @@index([courseId, date])
  @@index([teacherId, createdAt])
  @@index([status])
}

model AttendanceInvitation {
  id           String                    @id @default(cuid())
  sessionId    String
  session      AttendanceSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment                @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       AttendanceInvitationStatus @default(PENDING)
  invitedAt    DateTime                  @default(now())
  respondedAt  DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId, status])
  @@index([sessionId, status])
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  sessionId    String
  session      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status      AttendanceStatus @default(NOT_RECORDED)
  notes        String?
  recordedById String
  recordedBy   User             @relation("RecordedAttendanceRecords", fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId, status])
  @@index([sessionId, status])
}

model Assignment {
  id                  String         @id @default(cuid())
  courseId            String
  course              Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId              String?
  title               String
  description         String
  type                AssignmentType @default(HOMEWORK)
  maxPoints           Int            @default(100)
  weight              Float          @default(1.0)
  assignedAt          DateTime       @default(now())
  dueAt               DateTime
  allowLateSubmission Boolean        @default(false)
  latePenalty         Float?
  attachments         String[]
  isPublished         Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  submissions Submission[]

  @@index([courseId])
  @@index([dueAt])
  @@index([isPublished])
}

model Submission {
  id           String             @id @default(cuid())
  assignmentId String
  assignment   Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User               @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  content      String?
  attachments  String[]
  submittedAt  DateTime           @default(now())
  gradedAt     DateTime?
  pointsEarned Int?
  feedback     String?
  gradedBy     String?
  grader       User?              @relation("GradedSubmissions", fields: [gradedBy], references: [id], onDelete: SetNull)
  status       SubmissionStatus   @default(SUBMITTED)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([status])
}

model Test {
  id              String       @id @default(cuid())
  courseId        String
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?        @relation("TestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TestStatus   @default(DRAFT)
  durationMinutes Int          @default(30)
  maxAttempts     Int          @default(1)
  availableFrom   DateTime?
  availableUntil  DateTime?
  shuffleQuestions Boolean     @default(false)
  showResults     Boolean      @default(false)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  questions       Question[]
  attempts        TestAttempt[]

  @@index([courseId, status])
  @@index([courseId, availableFrom, availableUntil])
  @@index([createdById])
}

model Question {
  id           String       @id @default(cuid())
  testId       String
  test         Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  prompt       String
  type         QuestionType
  points       Int          @default(1)
  order        Int          @default(0)
  answerKey    String?
  choices      Choice[]
  answers      TestAnswer[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([testId, order])
  @@index([type])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId, order])
}

model TestAttempt {
  id              String            @id @default(cuid())
  testId          String
  test            Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId       String
  student         User              @relation("TestAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber   Int
  status          TestAttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime          @default(now())
  dueAt           DateTime
  submittedAt     DateTime?
  gradedAt        DateTime?
  resultsReleasedAt DateTime?
  score           Float?
  maxScore        Float?
  answers         TestAnswer[]

  @@unique([testId, studentId, attemptNumber])
  @@index([studentId, status])
  @@index([testId, status])
  @@index([dueAt])
}

model TestAnswer {
  id            String      @id @default(cuid())
  attemptId     String
  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoiceIds String[] @default([])
  responseText  String?
  pointsAwarded Float?
  isCorrect     Boolean?
  gradedAt      DateTime?
  updatedAt     DateTime    @updatedAt

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([attemptId, updatedAt])
}

model Notice {
  id          String      @id @default(cuid())
  title       String
  content     String
  type        NoticeType  @default(GENERAL)
  targetRoles UserRole[]
  authorId    String
  author      User        @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  publishAt   DateTime    @default(now())
  expireAt    DateTime?
  isPinned    Boolean     @default(false)
  isPublished Boolean     @default(false)
  attachments String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([authorId])
  @@index([publishAt])
  @@index([isPublished])
  @@index([type])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActivityType
  description String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model ContactConversation {
  id           String              @id @default(cuid())
  userId       String?
  user         User?               @relation("ContactOwner", fields: [userId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?               @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  name         String
  email        String
  subject      String
  status       ContactMessageStatus @default(NEW)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  messages     ContactMessage[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   ContactConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model ErrorIncident {
  id             String               @id @default(cuid())
  referenceId    String               @unique
  fingerprint    String
  severity       ErrorIncidentSeverity @default(MEDIUM)
  status         ErrorIncidentStatus   @default(NEW)
  code           String?
  message        String
  module         String?
  method         String?
  route          String?
  userId         String?
  userRole       UserRole?
  courseId       String?
  occurrenceCount Int                 @default(1)
  firstOccurredAt DateTime             @default(now())
  lastOccurredAt  DateTime             @updatedAt
  resolutionNotes String?
  technicalDetails String?
  createdAt      DateTime              @default(now())

  @@unique([fingerprint])
  @@index([severity, status])
  @@index([lastOccurredAt])
  @@index([module])
}